# Normalise line endings for text files
* text=auto

# Unity text-serialised assets
*.unity   text eol=lf
*.prefab  text eol=lf
*.asset   text eol=lf
*.mat     text eol=lf
*.anim    text eol=lf
*.controller text eol=lf
*.cs      text eol=lf
*.md      text eol=lf

# Optional: Git LFS for large binaries (only if the repo grows past ~500 MB; run `git lfs install` first)
# *.fbx  filter=lfs diff=lfs merge=lfs -text
# *.png  filter=lfs diff=lfs merge=lfs -text
# *.wav  filter=lfs diff=lfs merge=lfs -text
# *.ogg  filter=lfs diff=lfs merge=lfs -text
